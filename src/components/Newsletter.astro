---
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;

const posts = [
  {
    id: 1,
    title:
      "Inaugurado mi portfolio: un nuevo capítulo en mi desarrollo profesional",
    content:
      "Después de mucho tiempo pensando en cómo quería mostrar mi trabajo, hoy por fin inauguro mi portfolio. Era un proyecto que tenía pendiente desde hacía meses, pero quería hacerlo con cariño, con intención y sobre todo con una identidad que realmente me representara.\n\nHe aprovechado este proceso para repensar cómo diseño, cómo programo y cómo cuento lo que hago. El resultado es un espacio más cuidado, más visual y más alineado con la forma en la que entiendo el desarrollo web hoy en día.\n\nDetrás de cada sección hay decisiones muy concretas: desde usar Astro para tener un sitio rápido y moderno, hasta definir una estructura más clara para mis proyectos y artículos. Incluso pequeños detalles como las transiciones, el modo oscuro o la organización del contenido forman parte de esa filosofía: simple, funcional y agradable.\n\nEste portfolio no es solo una web nueva. Es una declaración de intenciones. Un punto de partida para seguir creando, aprendiendo y mostrando lo que me motiva del desarrollo.",
    date: "2025-11-10",
    readTime: "4 min",
    category: "Personal",
    slug: "inaugurado-mi-portfolio",
  },
];
---

<section
  class={`w-full bg-gradient-to-b from-gray-50 to-white dark:from-gray-900 dark:to-gray-950 ${className}`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24">
    <!-- Header -->
    <div class="text-center mb-12">
      <h2
        class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4"
      >
        Últimas publicaciones
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Artículos sobre desarrollo web, tecnología y mejores prácticas
      </p>
    </div>

    <!-- Posts Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
      {
        posts.map((post) => (
          <article
            data-modal-open
            data-post-id={post.id}
            data-post-title={post.title}
            data-post-content={post.content}
            data-post-date={post.date}
            data-post-readtime={post.readTime}
            data-post-category={post.category}
            class="group cursor-pointer bg-white dark:bg-gray-800 rounded-lg shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-200 dark:border-gray-700 flex flex-col"
          >
            <div class="p-6 pb-0">
              <span class="inline-block px-3 py-1 text-xs font-semibold text-blue-600 dark:text-blue-400 bg-blue-100 dark:bg-blue-900/30 rounded-full">
                {post.category}
              </span>
            </div>

            <div class="p-6 flex-grow flex flex-col">
              <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                {post.title}
              </h3>

              <div class="mb-4" style="height: 72px; overflow: hidden;">
                <p class="text-gray-600 dark:text-gray-400 line-clamp-3">
                  {post.content}
                </p>
              </div>

              <div class="flex items-center justify-between text-sm text-gray-500 dark:text-gray-500 mb-4">
                <time datetime={post.date}>
                  {new Date(post.date).toLocaleDateString("es-ES", {
                    year: "numeric",
                    month: "short",
                    day: "numeric",
                  })}
                </time>
                <span>{post.readTime} de lectura</span>
              </div>

              <div class="flex justify-end">
                <button class="text-sm cursor-pointer text-blue-800 dark:text-yellow-600 dark:text-yellow-400 hover:text-yellow-700 dark:hover:text-yellow-500 font-medium transition-colors duration-200 flex items-center gap-1">
                  Ver más
                  <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 5l7 7-7 7"
                    />
                  </svg>
                </button>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<!-- Modal -->
<div
  id="post-modal"
  class="modal-overlay hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4"
>
  <div
    class="modal-content bg-white dark:bg-gray-800 rounded-lg max-w-2xl w-full max-h-[90vh] overflow-y-auto shadow-2xl"
  >
    <div class="p-6 md:p-8">
      <!-- Close button -->
      <div class="flex justify-between items-start mb-4">
        <span
          id="modal-category"
          class="inline-block px-3 py-1 text-xs font-semibold text-blue-600 dark:text-blue-400 bg-blue-100 dark:bg-blue-900/30 rounded-full"
        >
        </span>
        <button
          id="modal-close"
          class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 transition-colors"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Modal content -->
      <h3
        id="modal-title"
        class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-4"
      >
      </h3>

      <div
        class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400 mb-6"
      >
        <time id="modal-date"></time>
        <span id="modal-readtime"></span>
      </div>

      <div
        id="modal-content"
        class="text-gray-700 dark:text-gray-300 leading-relaxed text-base whitespace-pre-wrap"
      >
      </div>
    </div>
  </div>
</div>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .modal-overlay {
    animation: fadeIn 0.2s ease-out;
  }

  .modal-content {
    animation: slideUp 0.3s ease-out;
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slideUp {
    from {
      transform: translateY(20px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>

<script>
  const modal = document.getElementById("post-modal");
  const modalClose = document.getElementById("modal-close");
  const openButtons = document.querySelectorAll("[data-modal-open]");

  // Open modal
  openButtons.forEach((button) => {
    button.addEventListener("click", (e) => {
      const target = e.currentTarget as HTMLElement;
      const title = target.dataset.postTitle || "";
      const content = target.dataset.postContent || "";
      const date = target.dataset.postDate || "";
      const readTime = target.dataset.postReadtime || "";
      const category = target.dataset.postCategory || "";

      // Populate modal
      document.getElementById("modal-title")!.textContent = title;
      document.getElementById("modal-content")!.textContent = content;
      document.getElementById("modal-category")!.textContent = category;
      document.getElementById("modal-readtime")!.textContent =
        `${readTime} de lectura`;

      const dateObj = new Date(date);
      document.getElementById("modal-date")!.textContent =
        dateObj.toLocaleDateString("es-ES", {
          year: "numeric",
          month: "short",
          day: "numeric",
        });

      // Show modal
      modal?.classList.remove("hidden");
      document.body.style.overflow = "hidden";
    });
  });

  // Close modal
  const closeModal = () => {
    modal?.classList.add("hidden");
    document.body.style.overflow = "";
  };

  modalClose?.addEventListener("click", closeModal);

  // Close on overlay click
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  // Close on Escape key
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !modal?.classList.contains("hidden")) {
      closeModal();
    }
  });
</script>
