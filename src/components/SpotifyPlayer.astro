---
interface Props {
    playlistId?: string;
    type?: "playlist" | "album" | "track" | "artist";
    title?: string;
}

const {
    playlistId = "0nT6dG81A2IRG78sAzZP47",
    type = "playlist",
    title = "Mi Música 🎵",
} = Astro.props;

const embedUrl = `https://open.spotify.com/embed/${type}/${playlistId}?utm_source=generator&theme=0`;
---

<!-- Floating Spotify Player -->
<div
    id="spotify-player-container"
    transition:persist
    class="fixed bottom-6 right-6 z-50 transition-all duration-300"
>
    <!-- Minimized button -->
    <button
        id="spotify-toggle-btn"
        class="spotify-minimized hidden bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white rounded-full p-4 shadow-2xl hover:scale-110 transition-all duration-300"
        aria-label="Abrir reproductor de Spotify"
    >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path
                d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"
            ></path>
        </svg>
    </button>

    <!-- Expanded player -->
    <div
        id="spotify-player-expanded"
        class="spotify-expanded bg-white dark:bg-gray-800 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 overflow-hidden"
    >
        <!-- Header -->
        <div
            id="spotify-player-header"
            class="flex items-center justify-between p-4 bg-gradient-to-r from-green-500 to-green-600"
        >
            <h3
                class="text-white font-semibold text-sm flex items-center gap-2"
            >
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                    <path
                        d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"
                    ></path>
                </svg>
                {title}
            </h3>
            <button
                id="spotify-minimize-btn"
                class="text-white hover:bg-white/20 rounded-full p-1 transition-colors duration-200"
                aria-label="Minimizar reproductor"
            >
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 9l-7 7-7-7"></path>
                </svg>
            </button>
        </div>

        <!-- Spotify Embed -->
        <div class="p-0">
            <iframe
                style="border-radius: 0; width: 100%; height: 352px;"
                src={embedUrl}
                allowfullscreen=""
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                loading="lazy"
                title={`Spotify ${type}`}></iframe>
        </div>
    </div>
</div>

<script>
    function initSpotifyPlayer() {
        const container = document.getElementById("spotify-player-container");
        const toggleBtn = document.getElementById("spotify-toggle-btn");
        const minimizeBtn = document.getElementById("spotify-minimize-btn");
        const expanded = document.getElementById("spotify-player-expanded");

        if (!container || !toggleBtn || !minimizeBtn || !expanded) return;

        // Check saved state
        const isMinimized =
            localStorage.getItem("spotify-minimized") === "true";

        if (isMinimized) {
            expanded.classList.add("hidden");
            toggleBtn.classList.remove("hidden");
        } else {
            expanded.classList.remove("hidden");
            toggleBtn.classList.add("hidden");
        }

        // Toggle to expanded
        toggleBtn.addEventListener("click", () => {
            expanded.classList.remove("hidden");
            toggleBtn.classList.add("hidden");
            localStorage.setItem("spotify-minimized", "false");
        });

        // Minimize
        minimizeBtn.addEventListener("click", () => {
            expanded.classList.add("hidden");
            toggleBtn.classList.remove("hidden");
            localStorage.setItem("spotify-minimized", "true");
        });
    }

    // Initialize on load
    initSpotifyPlayer();

    // Re-initialize after page transitions
    document.addEventListener("astro:after-swap", initSpotifyPlayer);
</script>

<style>
    iframe {
        border: none;
    }

    .spotify-expanded {
        width: 380px;
        max-width: calc(100vw - 3rem);
    }

    @media (max-width: 640px) {
        .spotify-expanded {
            width: calc(100vw - 3rem);
        }
    }

    #spotify-player-container {
        animation: slideIn 0.3s ease-out;
    }

    #spotify-player-header {
        position: absolute;
        width: 100%;
        border-radius: 80 80 0 0;
        top: -50px;
    }

    .encore-dark-theme {
        border-radius: 0% !important;
    }

    @keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
