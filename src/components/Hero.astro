---
const personalImageAlt = "Toni Carreras";
import Badge from "@/components/Badge.astro";
import LinkedInIcon from "@/components/icons/LinkedIn.astro";
import MailIcon from "@/components/icons/Mail.astro";
import SocialPill from "@/components/SocialPill.astro";
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full shadow-lg size-13"
      src="/duck.webp"
      alt={personalImageAlt}
    />
    <a
      href="https://linkedin.com/in/antoniocarrerasalarcon"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge variant="success">Focusing</Badge>
    </a>
  </div>
  <h1
    class="flex items-center text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
  >
    Hola, soy Toni <span class="text-3xl ml-2">👋</span>
  </h1>

  <p
    class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
  >
    Desarrollador <strong>Fullstack</strong> con más de 5 años de experiencia en
    el desarrollo de aplicaciones web escalables. Especializado en <strong
      >Symfony</strong
    > y <strong>Angular</strong>, con experiencia en integración de APIs REST,
    arquitectura Hexagonal, DDD. Actualmente formo
    parte del equipo de <strong>Clickedu (Sanoma Learning)</strong> en Barcelona,
    España.
  </p>

  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:antoniocarrerasalarcon@gmail.com">
      <MailIcon class="size-4" />
      Contáctame
    </SocialPill>
    <SocialPill href="https://linkedin.com/in/antoniocarrerasalarcon">
      <LinkedInIcon class="size-4" />
      LinkedIn
    </SocialPill>
  </nav>
</div>
