---
import Oleaje from './img/oleaje.png'
const photos = [
  {
    src: "/img/paseo.png",
    alt: "Descripción foto 1"
  },
  {
    src: "/img/perro.png",
    alt: "Descripción foto 2"
  },
  {
    src: "/img/oleaje.png",
    alt: "Descripción foto 3"
  },
  {
    src: "/img/burbuja.png",
    alt: "Descripción foto 4"
  },
  {
    src: "/img/barco.png",
    alt: "Descripción foto 5"
  }
];
---

<section class="w-full">
  <h2 class="text-3xl font-semibold mb-8 text-gray-800 dark:text-gray-100">
    Detrás de la cámara
  </h2>
  
  <div class="relative max-w-5xl mx-auto">
    <div class="overflow-hidden rounded-xl">
      <div id="carousel-track" class="flex transition-transform duration-500 ease-in-out">
        {photos.map((photo, index) => (
          <div class="min-w-full flex-shrink-0">
            <img 
              src={photo.src} 
              alt={photo.alt}
              class="w-full h-[400px] md:h-[500px] object-cover"
            />
          </div>
        ))}
      </div>
    </div>

    <button
      id="prev-btn"
      class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 dark:bg-gray-800/80 hover:bg-white dark:hover:bg-gray-800 rounded-full p-3 shadow-lg transition-all duration-300 hover:scale-110"
      aria-label="Anterior"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-800 dark:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <button
      id="next-btn"
      class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 dark:bg-gray-800/80 hover:bg-white dark:hover:bg-gray-800 rounded-full p-3 shadow-lg transition-all duration-300 hover:scale-110"
      aria-label="Siguiente"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-gray-800 dark:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Indicators -->
    <div class="flex justify-center gap-2 mt-6">
      {photos.map((_, index) => (
        <button
          class="carousel-indicator w-2.5 h-2.5 rounded-full bg-gray-300 dark:bg-gray-600 transition-all duration-300"
          data-index={index}
          aria-label={`Ir a foto ${index + 1}`}
        ></button>
      ))}
    </div>
  </div>
</section>

<script>
    function initCarousel() {
      const track = document.getElementById('carousel-track');
      const prevBtn = document.getElementById('prev-btn');
      const nextBtn = document.getElementById('next-btn');
      const indicators = document.querySelectorAll('.carousel-indicator');
      
      if (!track || !prevBtn || !nextBtn || indicators.length === 0) return;
      
      let currentIndex = 0;
      const totalSlides = indicators.length;
      let autoplayInterval: NodeJS.Timeout;
  
      function updateCarousel() {
        if (track) {
          track.style.transform = `translateX(-${currentIndex * 100}%)`;
        }
        
        // Update indicators
        indicators.forEach((indicator, index) => {
          if (index === currentIndex) {
            indicator.classList.add('bg-yellow-400', 'dark:bg-yellow-400', 'w-8');
            indicator.classList.remove('bg-gray-300', 'dark:bg-gray-600');
          } else {
            indicator.classList.remove('bg-yellow-400', 'dark:bg-yellow-400', 'w-8');
            indicator.classList.add('bg-gray-300', 'dark:bg-gray-600');
          }
        });
      }
  
      function nextSlide() {
        currentIndex = (currentIndex + 1) % totalSlides;
        updateCarousel();
      }
  
      function prevSlide() {
        currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
        updateCarousel();
      }
  
      // Event listeners
      prevBtn.addEventListener('click', prevSlide);
      nextBtn.addEventListener('click', nextSlide);
  
      indicators.forEach((indicator) => {
        indicator.addEventListener('click', (e) => {
          const target = e.target as HTMLElement;
          currentIndex = parseInt(target.dataset.index || '0');
          updateCarousel();
        });
      });
  
      // Auto-play
      autoplayInterval = setInterval(nextSlide, 5000);
  
      // Pause autoplay on hover
      const carouselContainer = document.querySelector('.relative.max-w-5xl');
      carouselContainer?.addEventListener('mouseenter', () => {
        clearInterval(autoplayInterval);
      });
  
      carouselContainer?.addEventListener('mouseleave', () => {
        autoplayInterval = setInterval(nextSlide, 5000);
      });
  
      // Initialize
      updateCarousel();
  
      // Cleanup on page transition
      document.addEventListener('astro:before-swap', () => {
        clearInterval(autoplayInterval);
      }, { once: true });
    }
  
    // Initialize on load
    initCarousel();
  
    // Re-initialize after page transition
    document.addEventListener('astro:after-swap', initCarousel);
  </script>
  
  <style>
    .carousel-indicator {
      cursor: pointer;
    }
  
    .carousel-indicator:hover {
      opacity: 0.7;
    }
  </style>