---
// Carousel.astro
// Carousel.astro
const photos = [
  { src: "/img/cope.jpg", alt: "Casas de colores en Copenhague" },
  { src: "/img/olas.jpg", alt: "Olas rompiendo con fuerza en la costa durante una tormenta" },
  { src: "/img/paseo.jpg", alt: "Camino rodeado de árboles en un bosque verde y frondoso" },
  { src: "/img/puesta.jpg", alt: "Silueta observando la puesta de sol" },
  { src: "/img/barco.jpg", alt: "Barco navegando frente al atardecer en el mar" },
  { src: "/img/vinyl.jpg", alt: "Tocadiscos reproduciendo un vinilo iluminado por luz azul" },
  { src: "/img/turron.jpg", alt: "Turrón con una pelota amarilla en la boca" },
  { src: "/img/burbuja.jpg", alt: "Niño jugando y soplando una burbuja transparente al aire" },
  { src: "/img/church.jpg", alt: "Churchill" }
];

---

<section class="w-full">
    <h2 class="text-3xl font-semibold mb-8 text-gray-800 dark:text-gray-100">
        Detrás de la cámara
    </h2>

    <div class="relative max-w-5xl mx-auto overflow-hidden rounded-xl">
        <!-- Carousel track -->
        <div
            id="carousel-track"
            class="flex overflow-x-auto scroll-snap-x snap-mandatory scroll-smooth"
        >
            {
                photos.map((photo) => (
                    <div class="flex-shrink-0 w-full snap-start">
                        <img
                            src={photo.src}
                            alt={photo.alt}
                            class="w-full h-[400px] md:h-[500px] object-cover"
                        />
                    </div>
                ))
            }
        </div>

        <!-- Buttons -->
        <button
            id="prev-btn"
            class="absolute left-4 top-1/2 -translate-y-1/2 bg-white/80 dark:bg-gray-800/80 hover:bg-white dark:hover:bg-gray-800 rounded-full p-3 shadow-lg transition-all duration-300 hover:scale-110"
            aria-label="Anterior"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-6 h-6 text-gray-800 dark:text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 19l-7-7 7-7"></path>
            </svg>
        </button>

        <button
            id="next-btn"
            class="absolute right-4 top-1/2 -translate-y-1/2 bg-white/80 dark:bg-gray-800/80 hover:bg-white dark:hover:bg-gray-800 rounded-full p-3 shadow-lg transition-all duration-300 hover:scale-110"
            aria-label="Siguiente"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="w-6 h-6 text-gray-800 dark:text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 5l7 7-7 7"></path>
            </svg>
        </button>

        <!-- Indicators -->
        <div class="flex justify-center gap-2 mt-6">
            {
                photos.map((_, index) => (
                    <button
                        class="carousel-indicator w-2.5 h-2.5 rounded-full bg-gray-300 dark:bg-gray-600 transition-all duration-300"
                        data-index={index}
                        aria-label={`Ir a foto ${index + 1}`}
                    />
                ))
            }
        </div>
    </div>
</section>

<script>
    function initCarousel() {
        const track = document.getElementById("carousel-track");
        const prevBtn = document.getElementById("prev-btn");
        const nextBtn = document.getElementById("next-btn");
        const indicators = document.querySelectorAll(".carousel-indicator");
        if (!track || !prevBtn || !nextBtn || indicators.length === 0) return;

        const totalSlides = indicators.length;
        let currentIndex = 0;

        function updateCarousel(index: number) {
            currentIndex = index;
            if (!track) return;
            const scrollLeft = track.clientWidth * currentIndex;
            track.scrollTo({ left: scrollLeft, behavior: "smooth" });

            indicators.forEach((ind, i) => {
                if (i === currentIndex) {
                    ind.classList.add(
                        "bg-blue-800",
                        "dark:bg-yellow-400",
                        "w-8",
                    );
                    ind.classList.remove("bg-gray-300", "dark:bg-gray-600");
                } else {
                    ind.classList.remove(
                        "bg-blue-800",
                        "dark:bg-yellow-400",
                        "w-8",
                    );
                    ind.classList.add("bg-gray-300", "dark:bg-gray-600");
                }
            });
        }

        function nextSlide() {
            updateCarousel((currentIndex + 1) % totalSlides);
        }

        function prevSlide() {
            updateCarousel((currentIndex - 1 + totalSlides) % totalSlides);
        }

        prevBtn.addEventListener("click", prevSlide);
        nextBtn.addEventListener("click", nextSlide);

        indicators.forEach((ind) => {
            ind.addEventListener("click", (e) => {
                const index = parseInt((e.target as HTMLElement).dataset.index || '0');
                updateCarousel(index);
            });
        });
        // Initialize
        updateCarousel(0);
    }

    initCarousel();
    document.addEventListener("astro:after-swap", initCarousel);
</script>

<style>
    #carousel-track::-webkit-scrollbar {
        display: none;
    } /* hide scrollbar */
    #carousel-track {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .carousel-indicator {
        cursor: pointer;
    }
    .carousel-indicator:hover {
        opacity: 0.7;
    }

    .scroll-snap-x {
        scroll-snap-type: x mandatory;
    }
    .snap-start {
        scroll-snap-align: start;
    }
</style>
