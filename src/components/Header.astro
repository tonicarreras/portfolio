---
// Header.astro
import Badge from "./Badge.astro";
import ThemeToggle from "./ThemeToggle.astro";
const currentPath = Astro.url.pathname;

const navItems = [
  { title: "Inicio", label: "inicio", url: "/" },
  { title: "Currículum", label: "curriculum", url: "/curriculum" },
  { title: "Sobre mí", label: "sobre-mi", url: "/about-me" }
];
---

<header class="fixed top-0 z-10 w-full mx-auto p-4 mt-2">
  <div class="relative flex items-center justify-end">
    <nav
      class="absolute left-1/2 -translate-x-1/2
             flex px-3 text-sm font-medium rounded-full
             text-gray-600 dark:text-gray-200 justify-center items-center"
    >
      {
        navItems.map((link) => (
          <a
            class={`relative block px-2 py-2 transition hover:text-blue-500 dark:hover:text-blue-500 ${
              currentPath === link.url ? "text-blue-500" : ""
            }`}
            aria-label={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
    </nav>

    <ThemeToggle/>

</header>

<style>
  nav {
    animation: nav-shadow 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;

    background-color: rgba(79, 79, 79, 0.32); 
  }


  @keyframes nav-shadow {
    0% {
      background-color: rgba(255, 255, 255, 0);
    }

    100% {
      box-shadow:
        0 10px 15px -3px rgba(0, 0, 0, 0.1),
        0 4px 6px -2px rgba(0, 0, 0, 0.05);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }
  }

  @media (prefers-color-scheme: dark) {
    @keyframes nav-shadow {
      0% {
        background-color: rgba(31, 41, 55, 0);
      }

      100% {
        box-shadow:
          0 10px 15px -3px rgba(0, 0, 0, 0.4),
          0 4px 6px -2px rgba(0, 0, 0, 0.3);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.1);
      }
    }
  }
</style>
