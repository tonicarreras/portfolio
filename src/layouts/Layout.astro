---
import "@fontsource-variable/onest";

import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import SpotifyPlayer from "@/components/SpotifyPlayer.astro";

interface Props {
  title: string;
  description: string;
}

const { description, title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>

  <body class="relative min-h-screen flex flex-col">
    <!-- Background decorativo -->
    <div
      class="fixed inset-0 z-[-2] bg-gray-200 dark:bg-gray-950
      bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(217,216,255,0.5),rgba(255,255,255,0.9))]
      dark:bg-[radial-gradient(ellipse_80%_80%_at_50%_-20%,rgba(120,119,198,0.3),rgba(255,255,255,0))]"
      aria-hidden="true"
    >
    </div>

    <!-- Header sticky o fijo -->
    <Header />

    <!-- Main content con flex-grow para empujar el footer al fondo -->
    <main class="flex-grow w-full">
      <slot />
    </main>

    <!-- Footer siempre al final -->
    <Footer />

    <!-- Spotify Player persistente -->
    <SpotifyPlayer />

    <style is:global>
      @import "../styles/global.css";
    </style>
  </body>
</html>