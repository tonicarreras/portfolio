---
import Layout from "@/layouts/Layout.astro";

import Briefcase from "@/components/icons/Briefcase.astro";
import CodeIcon from "@/components/icons/Code.astro";
import Experience from "@/components/Experience.astro";
import Stack from "@/components/Stack.astro";
import MainContainer from "@/components/MainContainer.astro";
import TitleSection from "@/components/TitleSection.astro";
---

<Layout
    description=""
    title="Sobre mí | Toni Carreras"
    title="Currículum | Toni Carreras | Portfolio"
>
    <MainContainer class="py-16 md:py-36" description="">
        <MainContainer id="experiencia">
            <TitleSection>
                <Briefcase class="size-8" />
                Experiencia laboral
            </TitleSection>
            <Experience />
        </MainContainer>

        <MainContainer id="proyectos">
            <TitleSection>
                <CodeIcon class="size-7" />
                Stack
            </TitleSection>
            <Stack />
        </MainContainer>
    </MainContainer>
</Layout>
